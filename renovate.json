{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMultipleMajorReleases"
  ],
  "enabledManagers": ["github-actions", "gomod"],
  "schedule": ["* * * * 6"],
  "timezone": "Europe/Berlin",
  "configMigration": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions (non-major)"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules (non-major)"
    },
    {
      "description": "Indirect updates are off by default; the govulncheck canary scans the linked binary, so a stale indirect module turns it red.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "libc is ccgo's runtime: its version must come from modernc.org/sqlite's go.mod, never from the tag list. Renovate's @v2 probe otherwise offers an abandoned 2024-02 branch as a major upgrade.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["modernc.org/libc", "modernc.org/libc/v2"],
      "enabled": false
    }
  ]
}
